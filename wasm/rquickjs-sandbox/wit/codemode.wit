/// codemode 沙箱：宿主调用 `run` 跑一段 JS；脚本要用命令时，组件把请求
/// `exec` 回宿主（宿主起 `wasm/coreutils-wasm` 那份 multicall 组件，内存 stdio）。
package tower-agent:codemode@0.1.0;

/// 命令层：宿主实现。参数/输出都是字节，避免把宿主类型塞进沙箱。
interface host {
  record exec-opts {
    stdin: option<list<u8>>,
    cwd: option<string>,
    timeout-ms: option<u32>,
  }
  record exec-result {
    code: s32,
    stdout: list<u8>,
    stderr: list<u8>,
  }
  record tool-descriptor {
    name: string,
    description: string,
    /// JSON Schema encoded as a JSON string.
    parameters: string,
    /// Optional JSON Schema encoded as a JSON string.
    output-schema: option<string>,
  }
  record tool-registration {
    name: string,
    handler: string,
    description: string,
    parameters: string,
    output-schema: option<string>,
  }

  /// 跑一个命令。`name` 是裸命令名（`cat`），宿主据此设 `argv[0]`。
  exec: func(name: string, args: list<string>, opts: exec-opts)
    -> result<exec-result, string>;
  /// 调用一个宿主工具；参数与返回值都是 JSON 字符串。
  tool-call: func(name: string, args-json: string) -> result<string, string>;
  /// 列出脚本可调用的工具及其元数据。
  tool-list: func() -> result<list<tool-descriptor>, string>;
  /// 注册一个由当前脚本 handler 实现的工具。
  tool-register: func(registration: tool-registration) -> result<bool, string>;
  /// 注销一个由脚本注册的工具。
  tool-unregister: func(name: string) -> result<bool, string>;
  /// 读取脚本私有状态；值为 JSON 字符串。
  state-get: func(key: string) -> result<option<string>, string>;
  /// 写入脚本私有状态；value-json 必须是合法 JSON。
  state-set: func(key: string, value-json: string) -> result<bool, string>;
  /// 写一条脚本日志。
  log: func(level: string, message: string) -> result<bool, string>;
  /// 设置状态栏片段；segment-json 是 JSON 对象。
  ui-status: func(segment-json: string) -> result<bool, string>;
  /// 设置面板；panel-json 是 JSON 对象。
  ui-panel: func(panel-json: string) -> result<bool, string>;
  /// 清理脚本 UI 贡献；id 为空时清空全部。
  ui-clear: func(id: option<string>) -> result<bool, string>;
  /// 设置工具结果渲染模板。
  ui-tool-render: func(tool: string, lines-json: string) -> result<bool, string>;
}

/// 沙箱导出：跑脚本。
interface sandbox {
  record run-opts {
    cwd: option<string>,
    timeout-ms: option<u32>,
    /// 是否允许 guest 直接访问 preopen 文件系统。
    fs: bool,
    /// 可用的命令名（宿主提供；脚本里会被生成成函数）。
    utils: list<string>,
  }
  record command-log {
    name: string,
    args: list<string>,
    code: s32,
  }
  record run-result {
    /// 脚本的 `return` 值（JSON；`undefined` → none）。脚本自己 return 的会原样带回。
    value: option<string>,
    /// `console.log` 收集到的输出（每行一条）。
    stdout: string,
    /// 执行过的命令流水（审计；上限见组件内 `MAX_COMMAND_LOG`）。
    commands: list<command-log>,
    /// 输出超限被截断。
    truncated: bool,
  }

  run: func(code: string, opts: run-opts) -> result<run-result, string>;
}

world codemode {
  import host;
  export sandbox;
}
